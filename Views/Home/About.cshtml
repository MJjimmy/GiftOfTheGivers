@{
    ViewData["Title"] = "About Us";
}

<!-- ABOUT HERO -->
<section class="about-hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <span class="hero-label">
                    ABOUT OUR ORGANISATION
                </span>

                <h1>
                    Serving Humanity
                    <span>With Purpose.</span>
                </h1>

                <p>
                    We connect donors, volunteers and humanitarian
                    projects to help communities affected by
                    disasters and emergencies.
                </p>

            </div>

            <div class="col-lg-5">

                <div class="about-hero-icon">

                    <i class="bi bi-heart-fill"></i>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- OUR STORY -->
<section class="about-story">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6 mb-4 mb-lg-0">

                <img src="https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?auto=format&fit=crop&w=900&q=80"
                     alt="Volunteers helping communities"
                     class="about-image">

            </div>

            <div class="col-lg-6">

                <span class="section-label">
                    OUR STORY
                </span>

                <h2>
                    People Helping
                    <span>People.</span>
                </h2>

                <p>
                    Humanitarian emergencies can affect communities
                    without warning. During these difficult moments,
                    coordinated support can make a meaningful difference.
                </p>

                <p>
                    Our platform is designed to bring together
                    humanitarian relief projects, volunteers and donors
                    through one accessible digital platform.
                </p>

                <p>
                    By making it easier for people to discover projects,
                    volunteer their skills and contribute financially,
                    we aim to strengthen community-based relief efforts.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- MISSION & VISION -->
<section class="mission-section">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-label">
                WHAT DRIVES US
            </span>

            <h2>
                Our Mission & Vision
            </h2>

        </div>


        <div class="row g-4 mt-4">

            <!-- MISSION -->
            <div class="col-lg-6">

                <div class="about-info-card">

                    <div class="about-card-icon">

                        <i class="bi bi-bullseye"></i>

                    </div>

                    <h3>
                        Our Mission
                    </h3>

                    <p>
                        To connect communities, volunteers and donors
                        with humanitarian relief initiatives that
                        provide meaningful support to people affected
                        by emergencies and disasters.
                    </p>

                </div>

            </div>


            <!-- VISION -->
            <div class="col-lg-6">

                <div class="about-info-card">

                    <div class="about-card-icon">

                        <i class="bi bi-eye-fill"></i>

                    </div>

                    <h3>
                        Our Vision
                    </h3>

                    <p>
                        To create a connected humanitarian community
                        where people can easily contribute their time,
                        resources and skills to help others in need.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- VALUES -->
<section class="values-section">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-label">
                OUR VALUES
            </span>

            <h2>
                What We Stand For
            </h2>

        </div>


        <div class="row g-4 mt-4">

            <!-- VALUE 1 -->
            <div class="col-md-4">

                <div class="value-card">

                    <i class="bi bi-heart-fill"></i>

                    <h4>
                        Compassion
                    </h4>

                    <p>
                        We put people and their needs at the centre
                        of every humanitarian effort.
                    </p>

                </div>

            </div>


            <!-- VALUE 2 -->
            <div class="col-md-4">

                <div class="value-card">

                    <i class="bi bi-people-fill"></i>

                    <h4>
                        Community
                    </h4>

                    <p>
                        We believe communities become stronger when
                        people work together to support one another.
                    </p>

                </div>

            </div>


            <!-- VALUE 3 -->
            <div class="col-md-4">

                <div class="value-card">

                    <i class="bi bi-shield-check"></i>

                    <h4>
                        Accountability
                    </h4>

                    <p>
                        We promote responsible management of donations,
                        volunteer participation and relief projects.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- CALL TO ACTION -->
<section class="about-cta">

    <div class="container text-center">

        <span>
            JOIN THE EFFORT
        </span>

        <h2>
            Together, We Can Make a Difference.
        </h2>

        <p>
            Whether you donate, volunteer or support a relief project,
            your contribution can help communities in need.
        </p>

        <div class="mt-4">

            <a href="#" class="btn btn-light me-2">
                Donate Now
            </a>

            <a href="#" class="btn btn-outline-light">
                Become a Volunteer
            </a>

        </div>

    </div>

</section>