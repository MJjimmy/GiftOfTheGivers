@{
    ViewData["Title"] = "Contact Us";
}

<section class="contact-hero">
    <div class="container text-center">

        <span class="section-label">
            GET IN TOUCH
        </span>

        <h1>
            Contact <span>Us</span>
        </h1>

        <p>
            Have a question, need assistance, or want to learn more
            about our humanitarian work? We are here to help.
        </p>

    </div>
</section>


<section class="contact-section">

    <div class="container">

        <div class="row g-5">

            <!-- CONTACT INFORMATION -->
            <div class="col-lg-5">

                <span class="section-label">
                    CONTACT INFORMATION
                </span>

                <h2>
                    We're Here to Help
                </h2>

                <p class="contact-intro">
                    Reach out to our team for general enquiries,
                    project information, volunteer support or
                    donation assistance.
                </p>


                <div class="contact-info-item">

                    <div class="contact-info-icon">
                        <i class="bi bi-envelope-fill"></i>
                    </div>

                    <div>
                        <h5>Email</h5>
                        <p>info@giftofthegivers.org</p>
                    </div>

                </div>


                <div class="contact-info-item">

                    <div class="contact-info-icon">
                        <i class="bi bi-telephone-fill"></i>
                    </div>

                    <div>
                        <h5>Phone</h5>
                        <p>+27 11 000 0000</p>
                    </div>

                </div>


                <div class="contact-info-item">

                    <div class="contact-info-icon">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>

                    <div>
                        <h5>Location</h5>
                        <p>Gauteng, South Africa</p>
                    </div>

                </div>


                <div class="contact-info-item">

                    <div class="contact-info-icon">
                        <i class="bi bi-clock-fill"></i>
                    </div>

                    <div>
                        <h5>Office Hours</h5>
                        <p>
                            Monday - Friday<br>
                            08:00 - 17:00
                        </p>
                    </div>

                </div>

            </div>


            <!-- CONTACT FORM -->
            <div class="col-lg-7">

                <div class="contact-form-card">

                    <span class="section-label">
                        SEND US A MESSAGE
                    </span>

                    <h2>
                        How Can We Help?
                    </h2>


                    <form>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Full Name
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Enter your full name">

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Email Address
                                </label>

                                <input type="email"
                                       class="form-control"
                                       placeholder="Enter your email">

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Phone Number
                                </label>

                                <input type="tel"
                                       class="form-control"
                                       placeholder="Enter your phone number">

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Subject
                                </label>

                                <select class="form-select">

                                    <option selected>
                                        Select a subject
                                    </option>

                                    <option>
                                        General Enquiry
                                    </option>

                                    <option>
                                        Donation Support
                                    </option>

                                    <option>
                                        Volunteer Support
                                    </option>

                                    <option>
                                        Relief Project
                                    </option>

                                    <option>
                                        Other
                                    </option>

                                </select>

                            </div>


                            <div class="col-12">

                                <label class="form-label">
                                    Message
                                </label>

                                <textarea class="form-control"
                                          rows="6"
                                          placeholder="Write your message here..."></textarea>

                            </div>


                            <div class="col-12">

                                <button type="button"
                                        class="btn btn-primary-custom">

                                    <i class="bi bi-send-fill me-2"></i>

                                    Send Message

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
</section>