@{
    ViewData["Title"] = "Home";
}

<!-- HERO SECTION -->
<!-- NEW HERO -->
<section class="hero2">
    <div class="container">
        <div class="row align-items-center g-5">

            <!-- LEFT: copy -->
            <div class="col-lg-6">

                <span class="hero2-eyebrow">
                    Humanitarian Relief &amp; Support
                </span>

                <h1 class="hero2-title">
                    Helping Communities
                    <span class="hero2-title-accent">When They Need It Most.</span>
                </h1>

                <p class="hero2-text">
                    Together, we can provide emergency assistance, essential
                    resources and hope to communities affected by disasters
                    and humanitarian crises.
                </p>

                <div class="hero2-actions">

                    <a asp-controller="Donation"
                       asp-action="Index"
                       class="btn hero2-btn-primary">

                        <i class="bi bi-heart-fill me-2" aria-hidden="true"></i>
                        Donate Now

                    </a>

                    <a asp-controller="Volunteer"
                       asp-action="Index"
                       class="btn hero2-btn-outline">

                        <i class="bi bi-people-fill me-2" aria-hidden="true"></i>
                        Become a Volunteer

                    </a>

                </div>

            </div>

            <!-- RIGHT: image + floating card -->
            <div class="col-lg-6">

                <div class="hero2-media">

                    <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=900&q=80"
                         alt="Children smiling and making peace signs"
                         class="hero2-image">

                    <div class="hero2-badge">

                        <span class="hero2-badge-icon">
                            <i class="bi bi-heart-fill" aria-hidden="true"></i>
                        </span>

                        <span>
                            <strong>Making an Impact</strong>
                            <small>Every contribution matters.</small>
                        </span>

                    </div>

                </div>

            </div>

        </div>
    </div>
</section>


<!-- IMPACT STATISTICS -->
<section class="impact-section">

    <div class="container">

        <div class="row text-center">

            <div class="col-md-4 mb-4 mb-md-0">

                <div class="impact-item">

                    <i class="bi bi-people-fill"></i>

                    <h2>500+</h2>

                    <p>Volunteers</p>

                </div>

            </div>


            <div class="col-md-4 mb-4 mb-md-0">

                <div class="impact-item">

                    <i class="bi bi-house-heart-fill"></i>

                    <h2>50+</h2>

                    <p>Relief Projects</p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="impact-item">

                    <i class="bi bi-heart-fill"></i>

                    <h2>10,000+</h2>

                    <p>People Supported</p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ABOUT / INTRODUCTION -->
<section class="intro-section">

    <div class="container">

        <div class="row align-items-center">

            <!-- IMAGE -->
            <div class="col-lg-6 mb-4 mb-lg-0">

                <img src="https://images.unsplash.com/photo-1593113598332-cd288d649433?auto=format&fit=crop&w=900&q=80"
                     alt="Community support"
                     class="intro-image" />

            </div>


            <!-- TEXT -->
            <div class="col-lg-6">

                <span class="section-label">
                    WHO WE ARE
                </span>

                <h2>
                    Standing Together
                    <span>For Humanity.</span>
                </h2>

                <p>
                    Our mission is to support communities affected by
                    disasters and emergencies by connecting people,
                    resources and humanitarian relief efforts.
                </p>

                <p>
                    Through coordinated relief projects, volunteers
                    and donations, we aim to ensure that assistance
                    reaches people who need it most.
                </p>

                <a asp-controller="Home"
                   asp-action="About"
                   class="text-link">
                    Learn More About Us
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>

            </div>

        </div>

    </div>

</section>


<!-- RELIEF PROJECTS -->
<section class="projects-section">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-label">
                OUR WORK
            </span>

            <h2>
                Current Relief Projects
            </h2>

            <p>
                Discover some of the humanitarian projects
                currently supporting communities.
            </p>

        </div>


        <div class="row g-4 mt-3">

            <!-- PROJECT 1 -->
            <div class="col-lg-4 col-md-6">

                <div class="project-card">

                    <div class="project-image">

                        <img src="https://images.unsplash.com/photo-1547683905-f686c993aae5?auto=format&fit=crop&w=700&q=80"
                             alt="Flood relief" />

                        <span class="project-status">
                            Ongoing
                        </span>

                    </div>

                    <div class="project-content">

                        <small>
                            <i class="bi bi-geo-alt"></i>
                            Gauteng, South Africa
                        </small>

                        <h4>
                            Gauteng Flood Relief
                        </h4>

                        <p>
                            Providing emergency food, water and
                            essential supplies to affected communities.
                        </p>

                        <a asp-controller="Projects"
                           asp-action="Details"
                           asp-route-id="1"
                           class="project-link">

                            View Project

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>

            </div>


            <!-- PROJECT 2 -->
            <div class="col-lg-4 col-md-6">

                <div class="project-card">

                    <div class="project-image">

                        <img src="https://images.unsplash.com/photo-1594708767771-a7502209ff51?auto=format&fit=crop&w=700&q=80"
                             alt="Food relief" />

                        <span class="project-status">
                            Ongoing
                        </span>

                    </div>

                    <div class="project-content">

                        <small>
                            <i class="bi bi-geo-alt"></i>
                            Limpopo, South Africa
                        </small>

                        <h4>
                            Limpopo Food Relief
                        </h4>

                        <p>
                            Delivering food parcels and essential
                            supplies to vulnerable households.
                        </p>

                        <a asp-controller="Projects"
                           asp-action="Details"
                           asp-route-id="2"
                           class="project-link">

                            View Project

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>

            </div>


            <!-- PROJECT 3 -->
            <div class="col-lg-4 col-md-6">

                <div class="project-card">

                    <div class="project-image">

                        <img src="https://images.unsplash.com/photo-1603398938378-e54eab446dde?auto=format&fit=crop&w=700&q=80"
                             alt="Medical assistance" />

                        <span class="project-status">
                            Ongoing
                        </span>

                    </div>

                    <div class="project-content">

                        <small>
                            <i class="bi bi-geo-alt"></i>
                            KwaZulu-Natal, South Africa
                        </small>

                        <h4>
                            Medical Assistance
                        </h4>

                        <p>
                            Supporting communities with medical
                            supplies and emergency healthcare.
                        </p>

                        <a asp-controller="Projects"
                           asp-action="Details"
                           asp-route-id="3"
                           class="project-link">

                            View Project

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <div class="text-center mt-5">

            <a asp-controller="Projects"
               asp-action="Index"
               class="btn btn-primary-custom">
                View All Projects
                <i class="bi bi-arrow-right ms-2"></i>
            </a>

        </div>

    </div>

</section>


<!-- DONATION CTA -->
<section class="donation-cta">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span class="cta-label">
                    MAKE A DIFFERENCE
                </span>

                <h2>
                    Your Support Can Help Save Lives.
                </h2>

                <p>
                    Every donation helps provide food, water,
                    medical assistance and other essential resources
                    to communities affected by crisis.
                </p>

            </div>

            <div class="col-lg-4 text-lg-end">

                <a asp-controller="Donation"
                   asp-action="Index"
                   class="btn btn-light btn-lg">

                    <i class="bi bi-heart-fill me-2"></i>

                    Donate Today

                </a>

            </div>

        </div>

    </div>

</section>