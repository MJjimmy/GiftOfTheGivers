@model GiftOfTheGivers.Models.Donation
@{
    ViewData["Title"] = "Donation Confirmation";

    var symbol = Model.Currency switch
    {
        "USD" => "$",
        "EUR" => "\u20AC",
        "GBP" => "\u00A3",
        _ => "R"
    };

    var donorDisplay = (Model.IsAnonymous || string.IsNullOrWhiteSpace(Model.DonorName))
        ? "Anonymous Donor"
        : Model.DonorName!;

    var typeDisplay = Model.DonationType == "Recurring" ? "Recurring" : "One-time";
    var certificateNumber = (string?)ViewBag.CertificateNumber ?? $"GOTG-{Model.CreatedAt.Year}-{Model.Id:D4}";
    var certificateSource = (string?)ViewBag.CertificateSource ?? "local";
}

<section class="donation-confirmation">

    <div class="container">

        <div class="confirmation-card text-center">

            <div class="confirmation-icon">
                <i class="bi bi-check-lg"></i>
            </div>

            <span class="section-label">
                DONATION RECEIVED
            </span>

            @if (certificateSource == "function")
            {
                <p class="mb-0 text-success small">
                    <i class="bi bi-cloud-check-fill me-1"></i>
                    Tax certificate generated by the <strong>TaxCertificate Azure Function</strong>.
                </p>
            }

            <h1>Thank You for Your Support!</h1>

            <p class="confirmation-message">
                Your contribution will help support humanitarian
                relief efforts and communities in need.
            </p>


            <!-- DONATION SUMMARY -->

            <div class="confirmation-summary">

                <div>
                    <span>Reference</span>
                    <strong>@Model.Reference</strong>
                </div>

                <div>
                    <span>Donation Amount</span>
                    <strong>@symbol@Model.Amount.ToString("N2")</strong>
                </div>

                <div>
                    <span>Donation Type</span>
                    <strong>@typeDisplay</strong>
                </div>

                <div>
                    <span>Currency</span>
                    <strong>@Model.Currency</strong>
                </div>

                <div>
                    <span>Donor</span>
                    <strong>@donorDisplay</strong>
                </div>

                <div>
                    <span>Supporting</span>
                    <strong>@(Model.Project?.Title ?? "General Relief Fund")</strong>
                </div>

            </div>


            <!-- TAX CERTIFICATE -->

            <div class="tax-certificate">

                <div class="tax-icon">
                    <i class="bi bi-file-earmark-pdf-fill"></i>
                </div>

                <div class="tax-content">

                    <h3>
                        Tax Certificate Generated
                    </h3>

                    <p>
                        A placeholder tax certificate has been generated
                        for this donation.
                    </p>

                    <button type="button"
                            class="btn btn-primary-custom"
                            onclick="showTaxCertificate()">

                        <i class="bi bi-file-earmark-text me-2"></i>

                        View Tax Certificate

                    </button>

                </div>

            </div>


            <!-- TAX CERTIFICATE PREVIEW -->

            <div id="taxCertificatePreview"
                 class="tax-certificate-preview"
                 style="display:none;">

                <div class="certificate-header">

                    <span>
                        GIFT OF THE GIVERS
                    </span>

                    <h2>
                        DONATION TAX CERTIFICATE
                    </h2>

                    <p>
                        Placeholder Certificate
                    </p>

                </div>


                <div class="certificate-body">

                    <div class="certificate-row">

                        <span>
                            Certificate Number
                        </span>

                        <strong>
                            @certificateNumber
                        </strong>

                    </div>


                    <div class="certificate-row">

                        <span>
                            Reference
                        </span>

                        <strong>
                            @Model.Reference
                        </strong>

                    </div>


                    <div class="certificate-row">

                        <span>
                            Donor
                        </span>

                        <strong>
                            @donorDisplay
                        </strong>

                    </div>


                    <div class="certificate-row">

                        <span>
                            Donation Amount
                        </span>

                        <strong>
                            @symbol@Model.Amount.ToString("N2")
                        </strong>

                    </div>


                    <div class="certificate-row">

                        <span>
                            Currency
                        </span>

                        <strong>
                            @Model.Currency
                        </strong>

                    </div>


                    <div class="certificate-row">

                        <span>
                            Donation Type
                        </span>

                        <strong>
                            @typeDisplay
                        </strong>

                    </div>


                    <div class="certificate-row">

                        <span>
                            Donation Date
                        </span>

                        <strong>
                            @Model.CreatedAt.ToString("dd MMMM yyyy")
                        </strong>

                    </div>

                </div>


                <div class="certificate-footer">

                    <p>
                        This is a prototype tax certificate generated for
                        demonstration purposes only.
                    </p>

                    <button type="button"
                            class="btn btn-outline-custom"
                            onclick="window.print()">

                        <i class="bi bi-printer me-2"></i>

                        Print Certificate

                    </button>

                </div>

            </div>


            <!-- ACTIONS -->

            <div class="confirmation-actions">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-custom">

                    <i class="bi bi-house-fill me-2"></i>

                    Return Home

                </a>

                <a asp-controller="Donation"
                   asp-action="Index"
                   class="btn btn-primary-custom">

                    Make Another Donation

                </a>

            </div>


            <p class="donation-note">
                Prototype only — no real payment has been processed.
            </p>

        </div>

    </div>

</section>


@section Scripts {

    <script>
        function showTaxCertificate() {
            var preview = document.getElementById('taxCertificatePreview');
            preview.style.display = (preview.style.display === 'none') ? 'block' : 'none';
        }
    </script>
}
