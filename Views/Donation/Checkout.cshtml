@model GiftOfTheGivers.ViewModels.DonationCheckoutViewModel
@{
    ViewData["Title"] = "Make a Donation";
}

<section class="donation-checkout">

    <div class="container">

        <div class="donation-header text-center">

            <span class="section-label">
                SUPPORT OUR MISSION
            </span>

            <h1>Make a Donation</h1>

            <p>
                Your contribution helps us provide food, medical
                assistance and essential support to communities in need.
            </p>

        </div>


        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="donation-card">

                    <form asp-controller="Donation"
                          asp-action="Checkout"
                          method="post">

                        <!-- DONATION TYPE -->

                        <div class="donation-form-section">

                            <h3>
                                Donation Type
                            </h3>

                            <p class="form-help">
                                Choose how often you would like to donate.
                            </p>

                            <div class="donation-options">

                                <label class="donation-option">

                                    <input asp-for="DonationType"
                                           type="radio"
                                           value="OneTime">

                                    <span>
                                        <strong>One-time</strong>
                                        <small>
                                            Make a single donation
                                        </small>
                                    </span>

                                </label>


                                <label class="donation-option">

                                    <input asp-for="DonationType"
                                           type="radio"
                                           value="Recurring">

                                    <span>
                                        <strong>Recurring</strong>
                                        <small>
                                            Support us regularly
                                        </small>
                                    </span>

                                </label>

                            </div>

                            <span asp-validation-for="DonationType" class="text-danger"></span>

                        </div>


                        <!-- CURRENCY -->

                        <div class="donation-form-section">

                            <h3>
                                Currency
                            </h3>

                            <p class="form-help">
                                Select your preferred currency.
                            </p>

                            <select asp-for="Currency" class="form-select">

                                <option value="ZAR">
                                    ZAR - South African Rand
                                </option>

                                <option value="USD">
                                    USD - US Dollar
                                </option>

                                <option value="EUR">
                                    EUR - Euro
                                </option>

                            </select>

                            <span asp-validation-for="Currency" class="text-danger"></span>

                        </div>


                        <!-- AMOUNT -->

                        <div class="donation-form-section">

                            <h3>
                                Donation Amount
                            </h3>

                            <p class="form-help">
                                Enter the amount you would like to donate.
                            </p>

                            <div class="input-group">

                                <span class="input-group-text">
                                    Amount
                                </span>

                                <input asp-for="Amount"
                                       type="number"
                                       class="form-control"
                                       placeholder="500"
                                       min="1"
                                       step="any">

                            </div>

                            <span asp-validation-for="Amount" class="text-danger"></span>

                            <div class="quick-amounts">

                                <button type="button"
                                        class="quick-amount"
                                        data-amount="100">
                                    100
                                </button>

                                <button type="button"
                                        class="quick-amount"
                                        data-amount="250">
                                    250
                                </button>

                                <button type="button"
                                        class="quick-amount"
                                        data-amount="500">
                                    500
                                </button>

                                <button type="button"
                                        class="quick-amount"
                                        data-amount="1000">
                                    1000
                                </button>

                            </div>

                        </div>


                        <!-- DONOR DETAILS -->

                        <div class="donation-form-section">

                            <h3>
                                Donor Information
                            </h3>

                            <p class="form-help">
                                You can donate using your account or
                                choose to remain anonymous.
                            </p>


                            <div class="anonymous-option">

                                <input asp-for="IsAnonymous"
                                       class="form-check-input"
                                       type="checkbox">

                                <label asp-for="IsAnonymous">

                                    <strong>
                                        Donate anonymously
                                    </strong>

                                    <small>
                                        Your name will not appear on the
                                        donation record.
                                    </small>

                                </label>

                            </div>


                            <div class="row g-3 mt-2">

                                <div class="col-md-6">

                                    <label asp-for="DonorName" class="form-label">
                                        Full Name
                                    </label>

                                    <input asp-for="DonorName"
                                           type="text"
                                           class="form-control"
                                           placeholder="Enter your name">

                                    <span asp-validation-for="DonorName" class="text-danger"></span>

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="Email" class="form-label">
                                        Email Address
                                    </label>

                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control"
                                           placeholder="Enter your email">

                                    <span asp-validation-for="Email" class="text-danger"></span>

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="Phone" class="form-label">
                                        Phone (optional)
                                    </label>

                                    <input asp-for="Phone"
                                           type="tel"
                                           class="form-control"
                                           placeholder="Enter your phone number">

                                    <span asp-validation-for="Phone" class="text-danger"></span>

                                </div>

                            </div>

                        </div>


                        <!-- PROJECT -->

                        <div class="donation-form-section">

                            <h3>
                                Support a Project
                            </h3>

                            <select asp-for="ProjectId"
                                    asp-items="ViewBag.Projects"
                                    class="form-select">
                            </select>

                            <p class="form-help mt-2">
                                Leave on General Relief Fund to let our teams
                                allocate your donation where it is needed most.
                            </p>

                        </div>


                        <!-- SUMMARY -->

                        <div class="donation-summary">

                            <div>

                                <span>
                                    Donation
                                </span>

                                <strong id="summaryAmount">
                                    R0.00
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Frequency
                                </span>

                                <strong id="summaryFrequency">
                                    One-time
                                </strong>

                            </div>

                        </div>


                        <!-- CONTINUE -->

                        <button type="submit"
                                class="btn btn-primary-custom w-100">

                            <i class="bi bi-heart-fill me-2"></i>

                            Continue Donation

                        </button>

                        <p class="donation-note text-center">

                            This is a prototype. No real payment will
                            be processed.

                        </p>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            var symbols = { ZAR: 'R', USD: '$', EUR: '\u20AC' };
            var amountInput = document.getElementById('Amount');
            var currencySelect = document.getElementById('Currency');
            var summaryAmount = document.getElementById('summaryAmount');
            var summaryFrequency = document.getElementById('summaryFrequency');

            function updateSummary() {
                var symbol = symbols[currencySelect.value] || '';
                var amount = parseFloat(amountInput.value || '0');
                summaryAmount.textContent = symbol + amount.toFixed(2);

                var selected = document.querySelector('input[name="DonationType"]:checked');
                summaryFrequency.textContent =
                    (selected && selected.value === 'Recurring') ? 'Recurring' : 'One-time';
            }

            currencySelect.addEventListener('change', updateSummary);
            amountInput.addEventListener('input', updateSummary);

            document.querySelectorAll('input[name="DonationType"]').forEach(function (radio) {
                radio.addEventListener('change', updateSummary);
            });

            document.querySelectorAll('.quick-amount').forEach(function (button) {
                button.addEventListener('click', function () {
                    amountInput.value = button.dataset.amount;
                    updateSummary();
                });
            });

            var anonymous = document.getElementById('IsAnonymous');
            var nameInput = document.getElementById('DonorName');

            anonymous.addEventListener('change', function () {
                nameInput.disabled = anonymous.checked;
                if (anonymous.checked) {
                    nameInput.value = '';
                }
            });
            nameInput.disabled = anonymous.checked;

            updateSummary();
        })();
    </script>
}
