@model GiftOfTheGivers.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<section class="account-section">

    <div class="container">

        <div class="account-card register-card">

            <div class="account-header text-center">

                <div class="account-icon">
                    <i class="bi bi-person-plus-fill"></i>
                </div>

                <span class="section-label">
                    JOIN OUR COMMUNITY
                </span>

                <h1>Create an Account</h1>

                <p>
                    Register to support humanitarian relief efforts.
                </p>

            </div>


            <form asp-controller="Account"
                  asp-action="Register"
                  method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="FirstName" class="form-label">
                            First Name
                        </label>

                        <input asp-for="FirstName"
                               type="text"
                               class="form-control"
                               placeholder="First name">

                        <span asp-validation-for="FirstName" class="text-danger"></span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="LastName" class="form-label">
                            Last Name
                        </label>

                        <input asp-for="LastName"
                               type="text"
                               class="form-control"
                               placeholder="Last name">

                        <span asp-validation-for="LastName" class="text-danger"></span>

                    </div>


                    <div class="col-12">

                        <label asp-for="Email" class="form-label">
                            Email Address
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="Enter your email">

                        <span asp-validation-for="Email" class="text-danger"></span>

                    </div>


                    <div class="col-12">

                        <label asp-for="Password" class="form-label">
                            Password
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Create a password">

                        <span asp-validation-for="Password" class="text-danger"></span>

                        <div class="form-text">
                            At least 6 characters, including an uppercase letter and a number.
                        </div>

                    </div>


                    <div class="col-12">

                        <label asp-for="ConfirmPassword" class="form-label">
                            Confirm Password
                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Confirm your password">

                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                    </div>


                    <div class="col-12">

                        <div class="form-check">

                            <input asp-for="AgreeToTerms"
                                   class="form-check-input"
                                   type="checkbox">

                            <label asp-for="AgreeToTerms"
                                   class="form-check-label">

                                I agree to the terms and conditions.

                            </label>

                            <span asp-validation-for="AgreeToTerms" class="text-danger d-block"></span>

                        </div>

                    </div>


                    <div class="col-12">

                        <button type="submit"
                                class="btn btn-primary-custom w-100">

                            <i class="bi bi-person-plus-fill me-2"></i>

                            Create Account

                        </button>

                    </div>

                </div>

            </form>


            <div class="account-divider">
                <span>OR</span>
            </div>


            <div class="text-center">

                <p>
                    Already have an account?
                </p>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="account-link">

                    Login

                </a>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />
}
