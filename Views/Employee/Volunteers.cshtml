@model GiftOfTheGivers.ViewModels.VolunteerManagementViewModel
@{
    ViewData["Title"] = "Volunteer Sign-ups";
}

<section class="employee-dashboard">

    <div class="container">

        <!-- HEADER -->
        <div class="dashboard-header">

            <div>
                <span class="section-label">
                    EMPLOYEE PORTAL
                </span>

                <h1>Volunteer Sign-ups</h1>

                <p>
                    Review people who have registered their interest
                    in supporting relief projects.
                </p>
            </div>

            <div class="dashboard-user">
                <i class="bi bi-person-circle"></i>

                <div>
                    <strong>@(User.Identity?.Name ?? "Employee")</strong>
                    <small>Employee</small>
                </div>
            </div>

        </div>


        <!-- SUMMARY -->
        <div class="row g-4 mb-5">

            <div class="col-md-4">

                <div class="dashboard-stat">

                    <div class="stat-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <div>
                        <span>Total Registrations</span>
                        <h3>@Model.TotalCount</h3>
                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="dashboard-stat">

                    <div class="stat-icon">
                        <i class="bi bi-person-check-fill"></i>
                    </div>

                    <div>
                        <span>Approved</span>
                        <h3>@Model.ApprovedCount</h3>
                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="dashboard-stat">

                    <div class="stat-icon">
                        <i class="bi bi-clock-fill"></i>
                    </div>

                    <div>
                        <span>Pending Review</span>
                        <h3>@Model.PendingCount</h3>
                    </div>

                </div>

            </div>

        </div>


        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">

                <i class="bi bi-check-circle-fill"></i>

                <div>
                    @successMessage
                </div>

            </div>
        }


        <!-- VOLUNTEER TABLE -->

        <div class="dashboard-section-header">

            <div>
                <span class="section-label">
                    REGISTERED VOLUNTEERS
                </span>

                <h2>Volunteer List</h2>
            </div>

            <a asp-controller="Employee"
               asp-action="Dashboard"
               class="dashboard-view-all">

                <i class="bi bi-arrow-left me-1"></i>
                Dashboard

            </a>

        </div>


        <div class="volunteer-table-card">

            <div class="table-responsive">

                <table class="table volunteer-table">

                    <thead>

                        <tr>

                            <th>Name</th>
                            <th>Contact</th>
                            <th>Skills</th>
                            <th>Availability</th>
                            <th>Area of Interest</th>
                            <th>Status</th>
                            <th>Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Volunteers.Any())
                        {
                            @foreach (var volunteer in Model.Volunteers)
                            {
                                <tr>

                                    <td>
                                        <strong>@volunteer.FullName</strong>
                                        <small class="d-block text-muted">
                                            @volunteer.CreatedAt.ToString("dd MMM yyyy")
                                        </small>
                                    </td>

                                    <td>
                                        @volunteer.Email
                                        <small class="d-block text-muted">@volunteer.Phone</small>
                                    </td>

                                    <td>@(string.IsNullOrWhiteSpace(volunteer.Skills) ? "-" : volunteer.Skills)</td>

                                    <td>@volunteer.Availability</td>

                                    <td>@(volunteer.AreaOfInterest ?? "-")</td>

                                    <td>
                                        <span class="volunteer-status">
                                            @volunteer.Status
                                        </span>
                                    </td>

                                    <td>

                                        <div class="d-flex gap-2">

                                            @if (volunteer.Status != "Approved")
                                            {
                                                <form asp-controller="Employee"
                                                      asp-action="SetVolunteerStatus"
                                                      asp-route-id="@volunteer.Id"
                                                      asp-route-status="Approved"
                                                      method="post">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-success"
                                                            title="Approve registration">

                                                        <i class="bi bi-check-lg"></i>

                                                    </button>

                                                </form>
                                            }

                                            @if (volunteer.Status != "Declined")
                                            {
                                                <form asp-controller="Employee"
                                                      asp-action="SetVolunteerStatus"
                                                      asp-route-id="@volunteer.Id"
                                                      asp-route-status="Declined"
                                                      method="post">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Decline registration">

                                                        <i class="bi bi-x-lg"></i>

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    No volunteer registrations yet. Sign-ups from the
                                    <a asp-controller="Volunteer" asp-action="Index">Volunteer page</a>
                                    will appear here.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</section>
