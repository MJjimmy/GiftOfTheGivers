@using Microsoft.AspNetCore.Identity
@inject SignInManager<GiftOfTheGivers.Models.AppUser> SignInManager
@inject UserManager<GiftOfTheGivers.Models.AppUser> UserManager
@{
    string userName = User.Identity?.Name ?? "Account";
    if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (!string.IsNullOrWhiteSpace(currentUser?.FullName))
        {
            userName = currentUser.FullName;
        }
    }
}
@*
  Layout for the site.
  Uses MVC tag helpers (asp-controller / asp-action) for navigation.
  Provides sections for per-page styles/scripts
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Gift of the Givers</title>

    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>
    
    <nav class="navbar navbar-expand-lg navbar-dark main-navbar" role="navigation" aria-label="Main navigation">
        <div class="container">
          
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index" aria-label="Gift of the Givers home">
                <div class="brand-icon">
                    <i class="bi bi-heart-fill" aria-hidden="true"></i>
                </div>
                <div class="ms-2">
                    <strong>GIFT OF THE GIVERS</strong>
                    <small class="d-block">Humanitarian Foundation</small>
                </div>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavigation">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="About">
                            About
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Projects"
                           asp-action="Index">
                            Relief Projects
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Volunteer"
                           asp-action="Index">
                            Volunteer
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Donation"
                           asp-action="Index">
                            Donate
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Contact">
                            Contact
                        </a>
                    </li>

@if (SignInManager.IsSignedIn(User))
    {
                    <li class="nav-item dropdown ms-lg-3 mt-2 mt-lg-0">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                           href="#"
                           id="userMenu"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <span class="login-circle" aria-hidden="true"><i class="bi bi-person"></i></span>
                            <span class="login-text">@userName</span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">

                            @if (User.IsInRole("Employee"))
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Employee" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-2"></i>Employee Portal
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                            }

                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </button>
                                </form>
                            </li>

                        </ul>
                    </li>
    }
    else
    {
                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                        <a class="nav-link d-flex align-items-center gap-2"
                           asp-controller="Account"
                           asp-action="Login"
                           aria-label="Login">
                            <span class="login-circle" aria-hidden="true"><i class="bi bi-person"></i></span>
                            <span class="login-text">Login</span>
                        </a>
                    </li>
    }
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <footer class="main-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5>GIFT OF THE GIVERS</h5>
                    <p>Providing humanitarian assistance and emergency relief to communities affected by disasters and humanitarian crises.</p>
                </div>

                <div class="col-lg-2">
                    <h5>Quick Links</h5>
                    <ul class="footer-links list-unstyled">
                        <li>
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>
                        <li>
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">
                                About
                            </a>
                        </li>
                        <li>
                            <a class="nav-link"
                               asp-controller="Projects"
                               asp-action="Index">
                                Relief Projects
                            </a>
                        </li>
                        <li>
                            <a class="nav-link"
                               asp-controller="Volunteer"
                               asp-action="Index">
                                Volunteer
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-lg-3">
                    <h5>Support Us</h5>
                    <ul class="footer-links list-unstyled">
                        <li><a asp-controller="Donation" asp-action="Index">Donate</a></li>
                        <li><a asp-controller="Volunteer" asp-action="Index">Become a Volunteer</a></li>
                        <li><a asp-controller="Projects" asp-action="Index">Relief Projects</a></li>
                    </ul>
                </div>

                <div class="col-lg-3">
                    <h5>Contact</h5>
                    <p><i class="bi bi-geo-alt me-2" aria-hidden="true"></i>South Africa</p>
                    <p><i class="bi bi-envelope me-2" aria-hidden="true"></i><a href="mailto:info@giftofthegivers.org">info@giftofthegivers.org</a></p>
                    <div class="social-icons">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="X / Twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
            </div>

            <hr />

            <div class="text-center">
                <p class="mb-0">&copy; @DateTime.Now.Year Gift of the Givers Foundation. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
